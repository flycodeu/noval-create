{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "dist-electron",
    "baseUrl": ".",
    "paths": {
      "@main/*": ["electron/*"]
    }
  },
  "include": ["electron/**/*.ts", "electron.vite.config.ts"]
}
