{
  "name": "novelforge",
  "version": "1.0.0",
  "description": "AI 小说智能创作平台",
  "novelforgeRuntimeNotes": {
    "nativeScripts": "Migration safety should be run via `npm run test:migrations` (Electron runtime). Direct `node scripts/migration-safety.test.cjs` execution is diagnostic-only and may hit better-sqlite3 ABI mismatch."
  },
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "node scripts/dev-web-full.cjs",
    "dev:web:frontend": "vite --host 127.0.0.1 --port 4175",
    "dev:web:backend": "electron scripts/local-web-backend.cjs",
    "dev:web:full": "node scripts/dev-web-full.cjs",
    "build:web": "vite build",
    "build": "npm run build:app && npm run package:win",
    "build:app": "electron-vite build",
    "build:dir": "npm run build:app && npm run package:dir",
    "build:win": "npm run build:app && npm run package:win",
    "build:installer": "npm run build:app && npm run package:installer",
    "build:installer:signed": "npm run build:app && npm run package:installer:signed",
    "build:mac": "electron-vite build && electron-builder --mac",
    "package:dir": "electron-builder --win dir",
    "package:installer": "node scripts/package-win.cjs",
    "package:installer:signed": "node scripts/package-win.cjs --signed",
    "package:win": "node scripts/package-win.cjs",
    "rebuild:native": "electron-builder install-app-deps",
    "preview": "electron-vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "postinstall": "npm run rebuild:native",
    "setup:nsis": "node scripts/setup-local-nsis.cjs",
    "generate:icon": "python scripts/generate-app-icon.py",
    "setup:nsis-resources": "node scripts/setup-local-nsis-resources.cjs",
    "setup:win-tools": "npm run setup:nsis && npm run setup:nsis-resources",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "npm run test:prompt-guardrails && npm run test:workflow-resilience && npm run test:workspace-routing && npm run test:migrations",
    "test:subplot": "node scripts/subplot-framework.test.cjs",
    "test:migrations": "electron scripts/migration-safety.test.cjs",
    "test:prompt-guardrails": "node scripts/prompt-guardrails.test.cjs",
    "test:workflow-resilience": "node scripts/workflow-resilience.test.cjs",
    "test:workspace-routing": "node scripts/workspace-routing.test.cjs",
    "test:longform-soak": "node scripts/longform-soak.cjs",
    "test:chapter-soak": "node scripts/chapter-soak.cjs",
    "soak:export-chapter-report": "electron scripts/export-chapter-soak-report.cjs",
    "eval:novel": "electron scripts/run-novel-ai-eval.cjs",
    "eval:novel:pipeline": "electron scripts/run-novel-ai-eval-pipeline.cjs",
    "eval:novel:verify": "electron scripts/verify-novel-ai-eval.cjs",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck": "npm run typecheck:web && npm run typecheck:node",
    "check:encoding": "node scripts/check-encoding.cjs",
    "check:user-messages": "node scripts/check-user-facing-messages.cjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.0",
    "@hello-pangea/dnd": "^18.0.1",
    "antd": "^5.15.0",
    "better-sqlite3": "^9.4.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.20",
    "docx": "^8.5.0",
    "drizzle-orm": "^0.30.8",
    "epub-gen-memory": "^1.1.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.22.0",
    "reactflow": "^11.11.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.9",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "drizzle-kit": "^0.20.14",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.58.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.1"
  },
  "author": "FlyLabs"
}
